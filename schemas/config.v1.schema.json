{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codelark.local/schemas/config.v1.schema.json",
  "title": "CodeLark config.json",
  "description": "Structured runtime and channel configuration stored at ~/.codelark/config.json.",
  "type": "object",
  "required": ["schemaVersion", "runtime", "channels"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/channelInstance"
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/$defs/noRetiredThreadIdentityFields"
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "runtime": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": {
          "const": "codex"
        },
        "codex": {
          "$ref": "#/$defs/codexRuntimeDefaults"
        },
        "claude": {
          "$ref": "#/$defs/claudeRuntimeDefaults"
        },
        "bridgeControl": {
          "$ref": "#/$defs/bridgeControlConfig"
        },
        "bridge": {
          "$ref": "#/$defs/globalBridgeConfig"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/noRetiredThreadIdentityFields"
        }
      ],
      "additionalProperties": true
    },
    "codexRuntimeDefaults": {
      "type": "object",
      "properties": {
        "defaultModel": {
          "type": "string"
        },
        "defaultMode": {
          "enum": ["normal", "yolo"]
        },
        "skipGitRepoCheck": {
          "type": "boolean"
        },
        "sandboxMode": {
          "enum": ["read-only", "workspace-write", "danger-full-access"]
        },
        "networkAccess": {
          "type": "boolean"
        },
        "reasoningEffort": {
          "enum": ["minimal", "low", "medium", "high", "xhigh"]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/noRetiredThreadIdentityFields"
        }
      ],
      "additionalProperties": true
    },
    "claudeRuntimeDefaults": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": ["sdk", "pty", "tmux"]
        },
        "executable": {
          "enum": ["claude", "ccr"]
        },
        "defaultModel": {
          "type": "string"
        },
        "permissionMode": {
          "enum": ["default", "acceptEdits", "bypassPermissions", "plan"]
        },
        "idleTimeoutMinutes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/noRetiredThreadIdentityFields"
        }
      ],
      "additionalProperties": true
    },
    "bridgeControlConfig": {
      "type": "object",
      "properties": {
        "defaultCodexProvider": {
          "enum": ["sdk", "pty", "tmux"]
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/noRetiredThreadIdentityFields"
        }
      ],
      "additionalProperties": true
    },
    "globalBridgeConfig": {
      "type": "object",
      "properties": {
        "defaultWorkspaceRoot": {
          "type": "string"
        },
        "historyMessageLimit": {
          "type": "integer",
          "minimum": 1
        },
        "streamStatusIdleStartSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "streamStatusCheckIntervalSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "uiAllowLan": {
          "type": "boolean"
        },
        "uiAccessToken": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/noRetiredThreadIdentityFields"
        }
      ],
      "additionalProperties": true
    },
    "channelInstance": {
      "type": "object",
      "required": ["id", "alias", "provider", "enabled", "createdAt", "updatedAt", "config"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": ["feishu"]
        },
        "enabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/feishuChannelConfig"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/noRetiredThreadIdentityFields"
        }
      ],
      "additionalProperties": true
    },
    "feishuChannelConfig": {
      "type": "object",
      "properties": {
        "appId": {
          "type": "string"
        },
        "appSecret": {
          "type": "string"
        },
        "site": {
          "enum": ["feishu", "lark"]
        },
        "allowedUsers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "streamingEnabled": {
          "type": "boolean"
        },
        "feedbackMarkdownEnabled": {
          "type": "boolean"
        },
        "requireMention": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/noRetiredThreadIdentityFields"
        }
      ],
      "additionalProperties": true
    },
    "noRetiredThreadIdentityFields": {
      "not": {
        "anyOf": [
          {
            "required": ["sdk_session_id"]
          },
          {
            "required": ["sdkSessionId"]
          },
          {
            "required": ["desktop_thread_id"]
          },
          {
            "required": ["desktopThreadId"]
          },
          {
            "required": ["thread_origin"]
          },
          {
            "required": ["threadOrigin"]
          },
          {
            "required": ["thread_id"]
          },
          {
            "required": ["threadId"]
          }
        ]
      }
    }
  }
}
